# Copy to .env and fill in. Only VITE_-prefixed vars reach the browser bundle.

# --- client (safe to expose) ---
VITE_SUPABASE_URL=
# New Supabase projects: the "publishable" key (sb_publishable_…).
# Older projects: use VITE_SUPABASE_ANON_KEY instead (the JWT anon key).
VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_ANON_KEY=

# --- seed script only — NEVER prefix with VITE_, never commit a real value ---
# New projects: the "secret" key (sb_secret_…). Older projects: the service_role JWT.
SUPABASE_SERVICE_ROLE_KEY=
